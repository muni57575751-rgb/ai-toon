# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI Text Generation Provider (Replaceable Free Tier)
# Get a free Gemini API key at: https://aistudio.google.com/
AI_PROVIDER=gemini
GEMINI_API_KEY=your-free-tier-gemini-api-key
AI_API_KEY=your-free-tier-api-key
AI_MODEL=gemini-3.5-flash-lite

# Quota & Performance Protection
STORY_CACHE_ENABLED=true
STORY_CACHE_TTL_MS=86400000
AI_REQUEST_TIMEOUT_MS=45000
RATE_LIMIT_MAX_REQUESTS=15
RATE_LIMIT_WINDOW_MS=60000
