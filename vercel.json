{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "output",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api?__url=/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__url=/api/$1"
    },
    {
      "source": "/((?!api(?:/|$)|health|assets/|favicon\\.ico|favicon\\.svg|icons\\.svg|robots\\.txt|manifest\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
