# Frontend Configuration
VITE_API_BASE_URL=/api
VITE_APP_TITLE=AI Toon

# Supabase Authentication & Database (Free Tier)
# In Supabase Dashboard: Go to Project Settings -> API
# 1. Copy 'Project URL' into VITE_SUPABASE_URL
# 2. Copy 'Project API Keys -> anon (public)' into VITE_SUPABASE_ANON_KEY
# (Never put your service_role secret key here!)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
