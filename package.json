{
  "name": "ai-toon",
  "version": "0.1.0",
  "description": "AI Toon — Story-Based Learning Using Artificial Intelligence",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=@ai-toon/shared && npm run build --workspace=backend && npm run build --workspace=frontend && npm run build:api",
    "build:shared": "npm run build --workspace=@ai-toon/shared",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:api": "npx esbuild api/index.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "typecheck": "npm run typecheck --workspace=@ai-toon/shared && npm run typecheck --workspace=ai-toon-backend && npm run typecheck --workspace=frontend",
    "typecheck:shared": "npm run typecheck --workspace=@ai-toon/shared",
    "typecheck:backend": "npm run typecheck --workspace=ai-toon-backend",
    "typecheck:frontend": "npm run typecheck --workspace=frontend"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0"
  }
}
